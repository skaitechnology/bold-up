# Copy to .env.local for local development. On Vercel these are set in
# Project Settings > Environment Variables (the Supabase integration fills most of them).
# Never commit real values.

# --- Supabase (required) -----------------------------------------------------
# Local stack: run `npm run db:start`, then copy the values it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# Public origin of the app, used for share links, Open Graph and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ----------------------------------------------------------------
# Show the "Continue with Google" button. Enable the Google provider in
# Supabase Auth first (client id + secret), then set this to 1.
NEXT_PUBLIC_GOOGLE_AUTH=0

# MapLibre style URL. Default: OpenFreeMap "liberty" (OpenStreetMap data, no key),
# recoloured at runtime in Bold Up's colours (src/components/map/map-theme.ts).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Protects /api/cron/* (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=

# --- Scripts only (migrations and seed) --------------------------------------
# Direct Postgres connection, used by `npm run db:push` against a hosted project.
# POSTGRES_URL_NON_POOLING=

# Passwords for the three demo accounts created by `npm run db:seed`.
# Leave empty to have the seed generate them and write .demo-credentials.md.
# DEMO_PASSWORD_COACH=
# DEMO_PASSWORD_CUSTOMER=
# DEMO_PASSWORD_ADMIN=
