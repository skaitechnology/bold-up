{
  "name": "bold-up",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:db": "bash scripts/test-db.sh",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "clsx": "^2.1.1",
    "lucide-react": "1.77.0",
    "maplibre-gl": "5.24.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "^8",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
